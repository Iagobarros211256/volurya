# Aplicacao
APP_ENV=production
ENV=production
PORT=8080
VOLURYA_DOMAIN=
ALLOWED_ORIGINS=

# PostgreSQL - rede privada Docker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=volurya
POSTGRES_PASSWORD=
POSTGRES_DB=volurya_db
POSTGRES_SSLMODE=disable

# Autenticacao
JWT_SECRET=
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=7

# Administrador inicial (opcional)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Stripe - utilizar somente chaves de teste inicialmente
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend
RESEND_API_KEY=

# Logs
LOG_LEVEL=info
