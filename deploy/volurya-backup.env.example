# Configuracao do backup PostgreSQL da Volurya
#
# Instalar na VPS como:
# /etc/volurya/backup.env
#
# Substituir pelo caminho absoluto da raiz do projeto.
VOLURYA_PROJECT_DIR=/substituir/pelo/caminho/volurya

# Opcional: usar somente se o .env estiver fora da raiz.
# VOLURYA_ENV_FILE=/caminho/absoluto/para/.env
